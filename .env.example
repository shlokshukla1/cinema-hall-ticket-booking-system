# Placeholder values only. All of these are optional for a local run with the default H2 database.
# Spring Boot does not read this file by itself: set these as real environment variables.

# Web server port (default 8080)
PORT=8080

# Signing key for login tokens, at least 32 characters. Blank = random key per start.
APP_JWT_SECRET=

# Database. Blank = local H2 file at ./data/cinema
# For PostgreSQL also set SPRING_PROFILES_ACTIVE=postgres
SPRING_PROFILES_ACTIVE=
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Seconds a seat hold lasts (default 300)
APP_HOLD_TTL_SECONDS=300

# Folder for admin-uploaded posters (default ./data/posters)
APP_POSTERS_DIR=./data/posters

# Create the dummy demo data when the database has no users (default true)
APP_SEED_ENABLED=true
